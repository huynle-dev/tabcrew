{
  "manifest_version": 3,
  "name": "ChromeUse v2",
  "version": "0.3.0",
  "description": "ChromeUse v2: isolated agent sessions as tab groups, driven by the local ChromeUse daemon",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChromeUse v2",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
