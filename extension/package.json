{
  "name": "@chromeuse/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension (MV3) for ChromeUse MCP browser automation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsx esbuild.config.ts",
    "build:watch": "tsx esbuild.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chromeuse/shared": "*",
    "devicon": "^2.17.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/markdown-it": "^14.1.2",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
