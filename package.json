{
  "name": "chromeuse-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP browser automation tools for controlling a real Chromium session",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huynle/chromeuse-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/huynle/chromeuse-mcp/issues"
  },
  "homepage": "https://github.com/huynle/chromeuse-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome",
    "chromium",
    "browser-automation",
    "ai-tools"
  ],
  "workspaces": [
    "shared",
    "extension",
    "native-host",
    "mcp-server",
    "gateway",
    "daemon",
    "extension-v2"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w shared",
    "typecheck": "npm run build -w shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test -w shared",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "qs": ">=6.15.2",
    "fast-uri": ">=3.1.2"
  }
}
